# ---------- Base de datos ----------
# Local (sin instalar nada): SQLite integrado en Node 24
DATABASE_URL=""
SQLITE_PATH="./data/ckl.db"
# Producción PostgreSQL (si DATABASE_URL empieza con postgres:// se usa PostgreSQL):
# DATABASE_URL="postgresql://usuario:clave@servidor:5432/ckl?schema=public"

# ---------- Evidencias ----------
# local = carpeta del servidor | azure = Azure Blob Storage
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# AZURE_STORAGE_CONNECTION_STRING=""
# AZURE_STORAGE_CONTAINER="evidencias"

# ---------- Autenticación Microsoft Entra ID (opcional) ----------
# Si se dejan vacías, la app funciona en "modo local": cada quien elige su nombre.
# NEXTAUTH_URL="http://localhost:3100"
# NEXTAUTH_SECRET="cadena-larga-aleatoria"
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""
NEXT_TELEMETRY_DISABLED=1
